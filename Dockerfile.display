# Pantalla virtual AISLADA para ver el navegador headed del host desde el celu.
# El navegador corre en el HOST (DISPLAY=localhost:99) y dibuja en este Xvfb;
# x11vnc + noVNC lo exponen por web. Acá NO corre ningún navegador ni stack.
FROM debian:bookworm-slim

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        tigervnc-standalone-server \
        novnc \
        websockify \
        fluxbox \
        x11-utils \
        x11-xserver-utils \
        procps \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/share/novnc/vnc.html /usr/share/novnc/index.html

# Reemplazar fbsetbg por un wrapper que setea el fondo petróleo con xsetroot.
# fluxbox llama a fbsetbg al arrancar y en cada resize; el original abre un xmessage
# molesto si no encuentra app de wallpaper. Este wrapper lo evita de raíz.
RUN printf '#!/bin/sh\nexec xsetroot -solid "#0F232D"\n' > /usr/bin/fbsetbg \
    && chmod +x /usr/bin/fbsetbg

ENV SCREEN_GEOMETRY=1360x768x24
ENV NOVNC_PORT=6080

COPY scripts/display-entrypoint.sh /usr/local/bin/display-entrypoint.sh
RUN chmod +x /usr/local/bin/display-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/display-entrypoint.sh"]
CMD ["sleep", "infinity"]
