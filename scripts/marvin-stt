#!/usr/bin/env bash
# Cliente de dictado: WAV por stdin -> texto transcripto por stdout.
# Lo invoca la app por SSH (push-to-talk). Si el daemon (marvin-stt.py, puerto 6091)
# no está corriendo, lo arranca vía systemd --user y espera a que levante.
#
#   marvin-stt < audio.wav              # transcribir
#   marvin-stt mode status              # ver modo de energia + estado del daemon
#   marvin-stt mode always              # siempre encendido (autostart + sin idle-exit)
#   marvin-stt mode ondemand            # default: arranca al usarlo, se apaga a los 10min
#
# Variables: MARVIN_STT_PORT (6091)
set -euo pipefail

PORT="${MARVIN_STT_PORT:-6091}"
URL="http://127.0.0.1:${PORT}"
MODE_FILE="$HOME/.config/marvin/stt-mode"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

up() { curl -fsS --max-time 2 "$URL/" >/dev/null 2>&1; }

LIVE_PORT="${MARVIN_STT_LIVE_PORT:-6092}"

if [ "${1:-}" = "mode" ]; then
    case "${2:-status}" in
        always)
            install -d "$(dirname "$MODE_FILE")"
            echo always > "$MODE_FILE"
            systemctl --user enable --now marvin-stt.service >/dev/null 2>&1 || true
            systemctl --user enable --now marvin-stt-live.service >/dev/null 2>&1 || true
            echo "STT: siempre encendido (batch + en vivo; arranca en boot, no se apaga solo)"
            ;;
        ondemand)
            install -d "$(dirname "$MODE_FILE")"
            echo ondemand > "$MODE_FILE"
            systemctl --user disable marvin-stt.service >/dev/null 2>&1 || true
            systemctl --user disable --now marvin-stt-live.service >/dev/null 2>&1 || true
            echo "STT: bajo demanda (default: arranca al dictar, se apaga tras 10 min sin uso)"
            ;;
        status)
            mode="$(cat "$MODE_FILE" 2>/dev/null || echo ondemand)"
            if up; then estado="$(curl -fsS --max-time 2 "$URL/")"; else estado="daemon apagado"; fi
            if (exec 3<>"/dev/tcp/127.0.0.1/$LIVE_PORT") 2>/dev/null; then live="en vivo: activo"; else live="en vivo: apagado"; fi
            echo "modo: $mode | $estado | $live"
            ;;
        *)
            echo "uso: marvin-stt mode [status|always|ondemand]" >&2; exit 2 ;;
    esac
    exit 0
fi

if ! up; then
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" \
        systemctl --user start marvin-stt.service 2>/dev/null || {
        echo "error: marvin-stt no está instalado en este host (corré setup-host.sh)" >&2
        exit 3
    }
    for _ in $(seq 1 30); do up && break; sleep 1; done
    up || { echo "error: el daemon marvin-stt no levantó (journalctl --user -u marvin-stt)" >&2; exit 4; }
fi

# El primer pedido puede tardar: descarga/carga del modelo (prewarm lo evita).
exec curl -fsS --max-time 180 --data-binary @- "$URL/stt"
