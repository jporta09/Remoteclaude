#!/usr/bin/env bash
# Habilita (o quita) el reenvío del display/render-daemon hacia un server.
#
#   marvin-allow-display <host>        # habilitar
#   marvin-allow-display -r <host>     # quitar
#   marvin-allow-display               # listar
set -euo pipefail

list="${MARVIN_DISPLAY_HOSTS:-$HOME/.config/marvin/display-hosts}"
install -d -m700 "$(dirname "$list")"
[ -f "$list" ] || { : > "$list"; chmod 600 "$list"; }

case "${1:-}" in
    "")
        echo "servers habilitados para el display remoto:"
        grep -v '^\s*\(#\|$\)' "$list" 2>/dev/null | sed 's/^/  /' || echo "  (ninguno)"
        ;;
    -r)
        host="${2:?uso: marvin-allow-display -r <host>}"
        grep -vxF "$host" "$list" > "$list.tmp" && mv "$list.tmp" "$list"
        echo "quitado: $host"
        ;;
    *)
        host="$1"
        grep -qxF "$host" "$list" 2>/dev/null || echo "$host" >> "$list"
        echo "habilitado: $host (vale para los SSH que hagas DESDE la app)"
        ;;
esac

# La cookie de X: sin esto el server habilitado llega al display por el túnel pero el
# servidor lo rechaza. Se copia acá para que habilitar un server sea UN paso, no dos.
XAUTH="$HOME/.config/marvin/Xauthority"
if [ -r "$XAUTH" ]; then
    if scp -q "$XAUTH" "$1:.config/marvin/Xauthority" 2>/dev/null; then
        echo "    cookie de X copiada a $1"
    else
        echo "    !! no pude copiar la cookie de X a $1 — copiala a mano:"
        echo "       ssh $1 'install -d -m700 ~/.config/marvin'"
        echo "       scp $XAUTH $1:.config/marvin/Xauthority"
    fi
else
    echo "    !! todavía no hay cookie de X (¿el contenedor 'display' está levantado?)"
fi
