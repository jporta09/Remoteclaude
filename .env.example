# Copiá este archivo a .env y completá los valores.

# Auth key de Tailscale (Admin console -> Settings -> Keys -> Generate auth key).
# Marcala "Reusable"; NO "Ephemeral" si querés nombre/IP estables.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Usuario del HOST al que salta la shell (donde se ejecuta todo).
# Ej.: jporta. Si no lo seteás, usa root.
HOST_USER=root

# Nombre del nodo en tu tailnet (MagicDNS). Default: remoteclaude
TS_HOSTNAME=remoteclaude

# Puerto SSH del gateway en el host. Default: 22 (si el host no corre su propio sshd).
SSH_PORT=22

# Contraseña de AUTO-ENROLAMIENTO. La usás UNA vez por dispositivo nuevo: al abrir la
# app sin autorizar, te la pide y la app sube sola su clave al gateway (estilo
# ssh-copy-id). Esta contraseña SOLO permite agregar una clave, nunca da shell, y el
# gateway sólo es alcanzable por tu tailnet. Dejala vacía para deshabilitar el enrol.
# Elegí una que puedas tipear en el celu. Cambiala cuando quieras (recreá el gateway).
ENROLL_PASSWORD=
