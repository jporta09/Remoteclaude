# Copiá este archivo a .env y completá los valores.

# Auth key de Tailscale para el contenedor `tailscale` (pone el HOST en tu tailnet).
# Admin console -> Settings -> Keys -> Generate. Marcala "Reusable"; NO "Ephemeral".
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Nombre del nodo (host) en tu tailnet (MagicDNS). Default: remoteclaude
TS_HOSTNAME=remoteclaude

# La terminal es SSH directo al sshd del HOST como tu usuario (no hay gateway). El
# usuario/puerto se configuran POR HOST dentro de la app (no acá). Autorizá la clave de
# la app (botón 🔑) en ~/.ssh/authorized_keys del host.

# --- Vinculación por QR del Tailscale embebido en la app (opcional) --------------------
# RemoteMarvin trae su PROPIO nodo Tailscale (no depende de la app de Tailscale). Para
# que entre a tu tailnet sin tocar la consola web, corrés en la PC (desde el repo):
#     ./scripts/ts-link-qr.sh
# que mintea una auth key efímera y la muestra como QR; la escaneás desde la app.
# (Requiere curl, jq y qrencode en el host.)
#
# Para eso necesitás un OAuth client (NO vence, a diferencia de una auth key):
#   1. Admin console -> Settings -> OAuth clients -> Generate.
#      Scope: "Auth Keys" (write). Tag: tag:remotemarvin (te ofrece agregarlo a la ACL).
#   2. Si no lo agregó solo, en la ACL (Access controls) sumá el tag a tagOwners:
#        "tagOwners": { "tag:remotemarvin": ["autogroup:admin"] }
#   3. Pegá acá el id y el secret que te da:
TS_OAUTH_CLIENT_ID=
TS_OAUTH_CLIENT_SECRET=
# Tag con el que se enrolan los celulares (debe coincidir con el del OAuth client).
TS_TAG=tag:remotemarvin

# --- Variables que usa el .env real y no estaban documentadas ---
# Usuario y puerto del host al que SSH-ea la app (informativos: la app los toma de su
# propia config de hosts; acá sirven para los scripts).
HOST_USER=tu-usuario
SSH_PORT=22

# OBSOLETA: ENROLL_PASSWORD era del auto-enrolamiento por contraseña, que se eliminó
# (la mitad server ya no existe y la app ahora muestra la clave pública para que la
# pegues en ~/.ssh/authorized_keys). Si la tenés en tu .env, borrala.
