# Copiá este archivo a .env y completá los valores.

# Auth key de Tailscale (Admin console -> Settings -> Keys -> Generate auth key).
# Marcala "Reusable"; NO "Ephemeral" si querés nombre/IP estables.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Usuario del HOST al que salta la shell (donde se ejecuta todo).
# Ej.: jporta. Si no lo seteás, usa root.
HOST_USER=root

# Nombre del nodo en tu tailnet (MagicDNS). Default: remoteclaude
TS_HOSTNAME=remoteclaude

# Puerto SSH del gateway en el host. Default: 22 (si el host no corre su propio sshd).
SSH_PORT=22
