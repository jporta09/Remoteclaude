# Copiá este archivo a .env y completá los valores.

# Auth key de Tailscale (Admin console -> Settings -> Keys -> Generate auth key).
# Recomendado: marcala como "Reusable". NO la marques "Ephemeral" si querés que el
# nodo conserve siempre el mismo nombre/IP en la tailnet.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
