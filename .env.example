# Copiá este archivo a .env y completá los valores.

# Auth key de Tailscale para el contenedor `tailscale` (pone el HOST en tu tailnet).
# Admin console -> Settings -> Keys -> Generate. Marcala "Reusable"; NO "Ephemeral";
# y asignale el Tag tag:remotemarvin (mismo tagOwners de abajo). IMPORTANTE: sin tag,
# la key del nodo del host VENCE a los ~180 dias y un dia el celu "no conecta" sin
# ningun aviso; con tag, el vencimiento queda deshabilitado (igual que el nodo del celu).
# (La auth key en si vence a los 90 dias como maximo: si re-enrolas el host mas adelante
# —p.ej. tras `teardown-host.sh --purgar-datos` o al migrar de maquina— y la key ya
# vencio, genera una nueva en la consola; el nodo ya enrolado no la necesita mas.)
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Nombre del nodo (host) en tu tailnet (MagicDNS). Default: remoteclaude
TS_HOSTNAME=remoteclaude

# La terminal es SSH directo al sshd del HOST como tu usuario (no hay gateway). El
# usuario/puerto se configuran POR HOST dentro de la app (no acá). Autorizá la clave de
# la app (botón 🔑) en ~/.ssh/authorized_keys del host.

# --- Vinculación por QR del Tailscale embebido en la app (opcional) --------------------
# RemoteMarvin trae su PROPIO nodo Tailscale (no depende de la app de Tailscale). Para
# que entre a tu tailnet sin tocar la consola web, corrés en la PC (desde el repo):
#     ./scripts/ts-link-qr.sh
# que mintea una auth key de un solo uso (NO efímera: el nodo del celu queda estable) y la
# muestra como QR; la escaneás desde la app.
# (Requiere curl, jq y qrencode en el host.)
#
# Para eso necesitás un OAuth client (NO vence, a diferencia de una auth key):
#   1. Admin console -> Settings -> OAuth clients -> Generate.
#      Scope: "Auth Keys" (write). Tag: tag:remotemarvin (te ofrece agregarlo a la ACL).
#   2. Si no lo agregó solo, en la ACL (Access controls) sumá el tag a tagOwners:
#        "tagOwners": { "tag:remotemarvin": ["autogroup:admin"] }
#   3. Pegá acá el id y el secret que te da:
TS_OAUTH_CLIENT_ID=
TS_OAUTH_CLIENT_SECRET=
# Tag con el que se enrolan los celulares (debe coincidir con el del OAuth client).
TS_TAG=tag:remotemarvin

# --- Pantalla virtual del visor 🖥 (opcional; el compose ya trae defaults) -------------
# Geometría inicial del escritorio virtual. El visor la ajusta sola por resize remoto,
# así que esto sólo fija el tamaño con el que arranca.
#SCREEN_GEOMETRY=1360x768x24
# Puerto de noVNC DENTRO del contenedor. Se publica sólo en loopback: la app llega
# tunelizándolo por su conexión SSH, nunca por la red.
#NOVNC_PORT=6080

# --- Claves que ya NO existen (si las tenés en tu .env, borralas) ----------------------
# HOST_USER / SSH_PORT: la app toma el usuario y el puerto de su propia lista de hosts;
#   ningún script los lee.
# ENROLL_PASSWORD: era del auto-enrolamiento por contraseña, eliminado. La app muestra su
#   clave pública para que la pegues en ~/.ssh/authorized_keys del host.
