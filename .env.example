# Copiá este archivo a .env y completá los valores.

# Auth key de Tailscale (Admin console -> Settings -> Keys -> Generate auth key).
# Marcala "Reusable"; NO "Ephemeral" si querés nombre/IP estables.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Usuario del HOST al que salta la shell (donde se ejecuta todo).
# Ej.: jporta. Si no lo seteás, usa root.
HOST_USER=root

# Nombre del nodo en tu tailnet (MagicDNS). Default: remoteclaude
TS_HOSTNAME=remoteclaude

# Puerto SSH del gateway en el host. Default: 22 (si el host no corre su propio sshd).
SSH_PORT=22

# Contraseña de AUTO-ENROLAMIENTO. La usás UNA vez por dispositivo nuevo: al abrir la
# app sin autorizar, te la pide y la app sube sola su clave al gateway (estilo
# ssh-copy-id). Esta contraseña SOLO permite agregar una clave, nunca da shell, y el
# gateway sólo es alcanzable por tu tailnet. Dejala vacía para deshabilitar el enrol.
# Elegí una que puedas tipear en el celu. Cambiala cuando quieras (recreá el gateway).
ENROLL_PASSWORD=

# --- Vinculación por QR del Tailscale embebido en la app (opcional) --------------------
# RemoteMarvin trae su PROPIO nodo Tailscale (no depende de la app de Tailscale). Para
# que entre a tu tailnet sin tocar la consola web, corrés en la PC:
#     docker compose exec gateway ts-link-qr
# que mintea una auth key efímera y la muestra como QR; la escaneás desde la app.
#
# Para eso necesitás un OAuth client (NO vence, a diferencia de una auth key):
#   1. Admin console -> Settings -> OAuth clients -> Generate.
#      Scope: "Auth Keys" (write). Tag: tag:remotemarvin (te ofrece agregarlo a la ACL).
#   2. Si no lo agregó solo, en la ACL (Access controls) sumá el tag a tagOwners:
#        "tagOwners": { "tag:remotemarvin": ["autogroup:admin"] }
#   3. Pegá acá el id y el secret que te da:
TS_OAUTH_CLIENT_ID=
TS_OAUTH_CLIENT_SECRET=
# Tag con el que se enrolan los celulares (debe coincidir con el del OAuth client).
TS_TAG=tag:remotemarvin
