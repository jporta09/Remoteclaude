<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Paleta CTR de Marvin (manual de identidad). Inspirada en monitores CRT viejos. -->
    <color name="marvin_green">#71BF44</color>      <!-- Verde CTR: principal / acentos -->
    <color name="marvin_petrol">#0F232D</color>     <!-- Verde petróleo: fondo / secundario -->
    <color name="marvin_amber">#FDB940</color>      <!-- Ámbar CTR: acento secundario -->
    <color name="marvin_fg">#F2F2F2</color>         <!-- Gris claro: texto sobre fondo oscuro -->
    <color name="marvin_muted">#7FA99B</color>      <!-- Verde alt apagado (subido de #5E8B7E para más contraste sobre el petróleo): negativo / mono -->
    <color name="marvin_red">#E05555</color>        <!-- Rojo de error/grabando (= Paleta.REC_FG): estados que piden acción -->
    <color name="marvin_surface">#16323D</color>    <!-- Panel sobre el petróleo -->

    <!-- Aliases usados por el tema y las vistas -->
    <color name="rc_bg">#0F232D</color>
    <color name="rc_surface">#16323D</color>
    <color name="rc_accent">#71BF44</color>
    <color name="rc_fg">#F2F2F2</color>
    <color name="ic_launcher_bg">#0F232D</color>
</resources>
