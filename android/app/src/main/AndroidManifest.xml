<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- La app habla SSH y abre noVNC por la tailnet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Cámara: escanear el QR de vinculación de Tailscale (ts-link-qr) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Dictado por voz push-to-talk (el STT corre en el host, acá solo se graba) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- allowBackup=false: las prefs guardan la config de hosts y (cifrada) la auth key
         de Tailscale, y filesDir el estado del nodo; nada de eso debería salir del
         dispositivo en un backup automático. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Remoteclaude">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Remoteclaude">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HostsActivity"
            android:exported="false" />

        <!-- Maneja rotación sin recrearse: preserva las pestañas y la activa, y evita
             reenganchar todas las sesiones SSH en cada giro (el terminal se reajusta solo
             vía TerminalView.onSizeChanged -> updateSize). -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Visor noVNC del navegador headed (M6). Maneja rotación sin recrearse. -->
        <activity
            android:name=".DisplayActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Visor de documentos compartidos (host:~/RemoteMarvinDocs) -->
        <activity
            android:name=".DocsActivity"
            android:exported="false" />
        <activity
            android:name=".DocViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Lector de QR (vincular Tailscale) forzado a vertical -->
        <activity
            android:name=".PortraitCaptureActivity"
            android:exported="false"
            android:screenOrientation="sensorPortrait"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />
    </application>
</manifest>
